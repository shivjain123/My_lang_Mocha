from "mocha-forge" import *;

function main(didLoad) -> null {
    var xtr: float[][] = [[3.2, 4.7, 1.4], [3.2, 4.5, 1.5], [3.1, 4.9, 1.5], [2.3, 4.0, 1.3], [2.8, 4.6, 1.5], [2.8, 4.5, 1.3], [3.3, 4.7, 1.6], [2.4, 3.3, 1.0], [2.9, 4.6, 1.3], [2.7, 3.9, 1.4], [2.0, 3.5, 1.0], [3.0, 4.2, 1.5], [2.2, 4.0, 1.0], [2.9, 4.7, 1.4], [2.9, 3.6, 1.3], [3.1, 4.4, 1.4], [3.0, 4.5, 1.5], [2.7, 4.1, 1.0], [2.2, 4.5, 1.5], [2.5, 3.9, 1.1], [3.3, 6.0, 2.5], [2.7, 5.1, 1.9], [3.0, 5.9, 2.1], [2.9, 5.6, 1.8], [3.0, 5.8, 2.2], [3.0, 6.6, 2.1], [2.5, 4.5, 1.7], [2.9, 6.3, 1.8], [2.5, 5.8, 1.8], [3.6, 6.1, 2.5], [3.2, 5.1, 2.0], [2.7, 5.3, 1.9], [3.0, 5.5, 2.1], [2.5, 5.0, 2.0], [2.8, 5.1, 2.4], [3.2, 5.3, 2.3], [3.0, 5.5, 1.8], [3.8, 6.7, 2.2], [2.6, 6.9, 2.3], [2.2, 5.0, 1.5]];
    var ytr: float[] = [7.0, 6.4, 6.9, 5.5, 6.5, 5.7, 6.3, 4.9, 6.6, 5.2, 5.0, 5.9, 6.0, 6.1, 5.6, 6.7, 5.6, 5.8, 6.2, 5.6, 6.3, 5.8, 7.1, 6.3, 6.5, 7.6, 4.9, 7.3, 6.7, 7.2, 6.5, 6.4, 6.8, 5.7, 5.8, 6.4, 6.5, 7.7, 7.7, 6.0];
    var xte: float[][] = [[3.2, 4.8, 1.8], [2.8, 4.0, 1.3], [2.5, 4.9, 1.5], [2.8, 4.7, 1.2], [2.9, 4.3, 1.3], [3.2, 5.7, 2.3], [2.8, 4.9, 2.0], [2.8, 6.7, 2.0], [2.7, 4.9, 1.8], [3.3, 5.7, 2.1]];
    var yte: float[] = [5.9, 6.1, 6.3, 6.1, 6.4, 6.9, 5.6, 7.7, 6.3, 6.7];

    var lr: LinearRegression = LinearRegression(0.02, 50000);
    lr.lasso(0.2);
    lr.fit(xtr, ytr);

    // weights and bias
    print(lr.weights[0], newLine=true);
    print(lr.weights[1], newLine=true);
    print(lr.weights[2], newLine=true);
    print(lr.bias, newLine=true);

    // test mse and r2
    print(lr.mse(xte, yte), newLine=true);
    print(lr.r2(xte, yte), newLine=true);
};