#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPILER="$SCRIPT_DIR/mocha_compile.py"
REPL="$SCRIPT_DIR/mocha_repl.py"
DOC="$SCRIPT_DIR/mocha_doc.py"

show_help() {
    echo "Mocha Compiler CLI"
    echo ""
    echo "Usage:"
    echo "  mocha <file.mch>                 Compile a file"
    echo "  mocha <file.mch> --debug         Compile with debug output"
    echo "  mocha execute <file.mch>         Compile and run immediately"
    echo "  mocha --lib <libfile.mch>        Compile a library"
    echo "  mocha doc <file.mch>             Generate documentation"
    echo "  mocha repl                       Launch interactive REPL"
    echo "  mocha help                       Show this message"
    echo ""
    echo "Coming soon:"
    echo "  mocha update                     Pull latest compiler + libraries"
}

if [ $# -eq 0 ]; then
    show_help
    exit 1
fi

if [ "$1" = "help" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    show_help
    exit 0
fi

if [ "$1" = "repl" ]; then
    python3 "$REPL"
    exit 0
fi

if [ "$1" = "doc" ]; then
    python3 "$DOC" "$(realpath "$2")"
    exit 0
fi

if [ "$1" = "execute" ]; then
    INPUT="$(realpath "$2")"
    OUTPUT="$(dirname "$INPUT")/$(basename "$INPUT" .mch)"
    python3 "$COMPILER" "$INPUT" "$OUTPUT"
    if [ $? -eq 0 ]; then
        set +e
        "$OUTPUT"
        EXEC_EXIT=$?
        set -e
        echo ""
        if [ $EXEC_EXIT -eq 0 ]; then
            echo "✅ Execution Done."
        else
            echo "❌ Execution failed (exit code $EXEC_EXIT)"
        fi
        exit $EXEC_EXIT
    else
        echo "❌ Compilation failed."
        exit 1
    fi
fi

if [ "$1" = "--lib" ]; then
    python3 "$COMPILER" --lib "$(realpath "$2")"
    exit 0
fi

INPUT="$(realpath "$1")"
OUTPUT="$(dirname "$INPUT")/$(basename "$INPUT" .mch)"
EXTRA_FLAGS=""

if [ "$2" = "--debug" ] || [ "$3" = "--debug" ]; then
    EXTRA_FLAGS="--debug"
fi

python3 "$COMPILER" "$INPUT" "$OUTPUT" $EXTRA_FLAGS