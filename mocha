#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPILER="$SCRIPT_DIR/mocha_compile.py"
REPL="$SCRIPT_DIR/mocha_repl.py"
DOC="$SCRIPT_DIR/mocha_doc.py"

show_help() {
    echo "Mocha Compiler CLI"
    echo ""
    echo "Usage:"
    echo "  mocha <file.mch>                 Compile a file"
    echo "  mocha <file.mch> --debug         Compile with debug output"
    echo "  mocha execute <file.mch>         Compile and run immediately"
    echo "  mocha --lib <libfile.mch>        Compile a library"
    echo "  mocha doc <file.mch>             Generate documentation"
    echo "  mocha repl                       Launch interactive REPL"
    echo "  mocha wasm <file.mch> [fn ...]   Build a WebAssembly module"
    echo "  mocha help                       Show this message"
    echo "  mocha serve [page.html] [port]   Open a wasm page in the browser"
    echo "  mocha web <file.mch> [fn ...]    Build as WebAssembly and open it in the browser"
    echo "  mocha update                     Pull the latest compiler + libraries"
    echo "  mocha libs [name ...]            Rebuild all libraries (or just the named ones)"
}

if [ $# -eq 0 ]; then
    show_help
    exit 1
fi

if [ "$1" = "help" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    show_help
    exit 0
fi

if [ "$1" = "update" ]; then
    exec python3 "$SCRIPT_DIR/mocha_update.py" update
fi

python3 "$SCRIPT_DIR/mocha_update.py" check || true

if [ "$1" = "libs" ]; then
    shift
    python3 "$SCRIPT_DIR/mocha_libs.py" "$@"
    exit $?
fi

if [ "$1" = "repl" ]; then
    python3 "$REPL"
    exit 0
fi

if [ "$1" = "doc" ]; then
    python3 "$DOC" "$(realpath "$2")"
    exit 0
fi

if [ "$1" = "execute" ]; then
    INPUT="$(realpath "$2")"
    OUTPUT="$(dirname "$INPUT")/$(basename "$INPUT" .mch)"
    if python3 "$COMPILER" "$INPUT" "$OUTPUT"; then
        set +e
        "$OUTPUT"
        EXEC_EXIT=$?
        set -e
        echo ""
        if [ $EXEC_EXIT -eq 0 ]; then
            echo "✅ Execution Done."
        else
            echo "❌ Execution failed (exit code $EXEC_EXIT)"
        fi
        exit $EXEC_EXIT
    else
        echo "❌ Compilation failed."
        exit 1
    fi
fi

if [ "$1" = "--lib" ]; then
    python3 "$COMPILER" --lib "$(realpath "$2")"
    exit 0
fi

if [ "$1" = "wasm" ]; then
    if [ -z "$2" ]; then
        echo "Usage: mocha wasm <file.mch> [function ...]"
        exit 1
    fi
    INPUT="$(realpath "$2")"
    OUTPUT="$(dirname "$INPUT")/$(basename "$INPUT" .mch)"
    shift 2
    python3 "$COMPILER" --wasm "$INPUT" "$OUTPUT" "$@"
    exit 0
fi

if [ "$1" = "serve" ]; then
    if [ -z "$2" ]; then
        python3 "$SCRIPT_DIR/mocha_serve.py"
    else
        python3 "$SCRIPT_DIR/mocha_serve.py" "$(realpath "$2")" $3
    fi
    exit 0
fi

if [ "$1" = "web" ]; then
    if [ -z "$2" ]; then
        echo "Usage: mocha web <file.mch> [function ...]"
        exit 1
    fi
    INPUT="$(realpath "$2")"
    OUTPUT="$(dirname "$INPUT")/$(basename "$INPUT" .mch)"
    shift 2
    python3 "$COMPILER" --wasm "$INPUT" "$OUTPUT" "$@"
    python3 "$SCRIPT_DIR/mocha_serve.py" "$OUTPUT.html"
    exit 0
fi

case "$1" in
    *.mch) ;;
    *)
        echo "Unknown command '$1'. Run 'mocha help' to see available commands."
        exit 1
        ;;
esac

INPUT="$(realpath "$1")"
OUTPUT="$(dirname "$INPUT")/$(basename "$INPUT" .mch)"
EXTRA_FLAGS=""

if [ "$2" = "--debug" ] || [ "$3" = "--debug" ]; then
    EXTRA_FLAGS="--debug"
fi

python3 "$COMPILER" "$INPUT" "$OUTPUT" $EXTRA_FLAGS