{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mocha",
  "scopeName": "source.mch",
  "fileTypes": ["mch"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#classes" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mocha",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mocha",
          "begin": "\"\"\"",
          "end": "\"\"\""
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mocha",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mocha",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.mocha",
          "match": "'[^']*'",
          "comment": "char literals"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mocha",
          "match": "\\b(if|else|while|do|for|each|in|match|case|default|return|break|continue|when)\\b"
        },
        {
          "name": "keyword.declaration.mocha",
          "match": "\\b(function|class|interface|extends|implements|var|const|lambda|native|alloc|import|from|as|extend|tag)\\b"
        },
        {
          "name": "keyword.modifier.mocha",
          "match": "\\b(private|protected|shared|this|new)\\b"
        },
        {
          "name": "keyword.operator.logical.mocha",
          "match": "\\b(and|or|not|null|true|false)\\b"
        },
        {
          "name": "keyword.other.mocha",
          "match": "\\b(didLoad|print|str|int|float|bool|char|vast)\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.mocha",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "comment": "SCREAMING_CASE constants — blue",
          "name": "constant.other.mocha",
          "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.mocha",
          "match": "\\b(int|float|bool|char|str|vast|null|dict|set|tuple)\\b"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "comment": "function declaration name — yellow",
          "name": "entity.name.function.mocha",
          "match": "(?<=function\\s)([a-zA-Z_][a-zA-Z0-9_]*)"
        },
        {
          "comment": "function call — yellow",
          "name": "entity.name.function.call.mocha",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },

    "classes": {
      "patterns": [
        {
          "comment": "class name after class/interface/extends/implements keyword — green",
          "name": "entity.name.type.class.mocha",
          "match": "(?<=\\b(?:class|interface|extends|implements)\\s)([A-Z][a-zA-Z0-9_]*)"
        },
        {
          "comment": "type annotations after colon — green",
          "name": "entity.name.type.mocha",
          "match": "(?<=:\\s*)([A-Z][a-zA-Z0-9_]*)"
        }
      ]
    },

    "tags": {
      "patterns": [
        {
          "comment": "Tag access: Color.RED",
          "name": "constant.language.tag.mocha",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\.[A-Z][A-Z0-9_]+\\b"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.mocha",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.mocha",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.mocha",
          "match": "(\\+=|-=|\\*=|/=|=)"
        },
        {
          "name": "keyword.operator.comparison.mocha",
          "match": "(==|!=|<=|>=|<(?!=)|>(?!=))"
        },
        {
          "name": "keyword.operator.arithmetic.mocha",
          "match": "(\\+|-|\\*|/|%|\\+\\+|--)"
        },
        {
          "name": "keyword.operator.range.mocha",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.tuple.mocha",
          "match": "#"
        },
        {
          "name": "keyword.operator.arrow.mocha",
          "match": "->"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.mocha",
          "match": ";"
        },
        {
          "name": "punctuation.section.block.mocha",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.mocha",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.mocha",
          "match": "[()]"
        }
      ]
    }
  }
}
