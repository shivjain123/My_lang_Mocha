{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mocha",
  "scopeName": "source.mch",
  "fileTypes": ["mch", "mchi"],
  "patterns": [
    { "include": "#docstrings" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#tags" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#classes" },
    { "include": "#functions" },
    { "include": "#native_symbols" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {

    "docstrings": {
      "patterns": [
        {
          "comment": "Mocha docstring: ~~ rest of line (single line, no closing)",
          "name": "comment.block.documentation.mocha",
          "match": "~~.*$"
        }
      ]
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mocha",
          "match": "//.*$"
        },
        {
          "comment": "Multi-line block comment",
          "name": "comment.block.mocha",
          "begin": "\"\"\"",
          "end": "\"\"\""
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mocha",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mocha",
              "match": "\\\\."
            },
            {
              "comment": "format string: $name, $0, $0|2f",
              "name": "variable.other.interpolated.mocha",
              "match": "\\$[a-zA-Z0-9_]+(\\|[^\"]*)?"
            }
          ]
        }
      ]
    },

    "tags": {
      "patterns": [
        {
          "comment": "tag keyword — light blue via tokenColorCustomizations",
          "name": "keyword.declaration.tag.mocha",
          "match": "\\btag\\b"
        },
        {
          "comment": "tag name after tag keyword — gold",
          "name": "entity.name.tag.mocha",
          "match": "(?<=\\btag\\s)([A-Z][a-zA-Z0-9_]*)"
        },
        {
          "comment": "tag variant access: Color.RED — gold",
          "name": "entity.name.tag.variant.mocha",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\.([A-Z][A-Z0-9_]+)\\b"
        },
        {
          "comment": "tag variant declaration inside tag body — gold (SCREAMING_CASE)",
          "name": "entity.name.tag.variant.mocha",
          "match": "\\b[A-Z][A-Z0-9_]{1,}\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mocha",
          "match": "\\b(if|else|while|do|for|each|in|match|case|default|return|break|continue|when)\\b"
        },
        {
          "name": "keyword.declaration.mocha",
          "match": "\\b(function|class|interface|extends|implements|var|const|lambda|native|alloc|import|from|as|extend)\\b"
        },
        {
          "name": "keyword.modifier.mocha",
          "match": "\\b(private|protected|shared|this|new)\\b"
        },
        {
          "name": "keyword.operator.word.mocha",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.other.mocha",
          "match": "\\b(didLoad|print|constructor)\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.mocha",
          "match": "\\b(int|float|bool|str|vast|null|dict|set|void)\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.mocha",
          "match": "\\b(true|false)\\b"
        }
      ]
    },

    "classes": {
      "patterns": [
        {
          "comment": "class/interface name after keyword",
          "name": "entity.name.type.class.mocha",
          "match": "(?<=\\b(?:class|interface|extends|implements)\\s)([A-Z][a-zA-Z0-9_]*)"
        },
        {
          "comment": "type annotation after colon: var x: MyType",
          "name": "entity.name.type.mocha",
          "match": "(?<=:\\s*)([A-Z][a-zA-Z0-9_]*)"
        },
        {
          "comment": "constructor call: new MyClass(...)",
          "name": "entity.name.type.mocha",
          "match": "(?<=\\bnew\\s)([A-Z][a-zA-Z0-9_]*)"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "comment": "function declaration name — yellow",
          "name": "entity.name.function.mocha",
          "match": "(?<=\\bfunction\\s)([a-zA-Z_][a-zA-Z0-9_]*)"
        },
        {
          "comment": "function/method call — yellow",
          "name": "entity.name.function.call.mocha",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },

    "native_symbols": {
      "patterns": [
        {
          "comment": "RHS symbol after native keyword — same yellow as function names",
          "name": "entity.name.function.mocha",
          "match": "(?<=\\bnative\\s)([a-zA-Z_][a-zA-Z0-9_]*)"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.mocha",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.mocha",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.mocha",
          "match": "(\\+=|-=|\\*=|/=|=)"
        },
        {
          "name": "keyword.operator.comparison.mocha",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.mocha",
          "match": "(\\+|-|\\*|/|%|\\+\\+|--)"
        },
        {
          "name": "keyword.operator.bitwise.mocha",
          "match": "(&|\\||\\^|~|<<|>>)"
        },
        {
          "name": "keyword.operator.range.mocha",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.tuple.mocha",
          "match": "#"
        },
        {
          "name": "keyword.operator.arrow.mocha",
          "match": "->"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.mocha",
          "match": ";"
        },
        {
          "name": "punctuation.section.block.mocha",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.mocha",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.mocha",
          "match": "[()]"
        }
      ]
    }
  }
}